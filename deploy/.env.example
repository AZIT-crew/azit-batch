# 참고용. 실제 /opt/azit-batch/.env 는 deploy 워크플로우가 GitHub Secrets(환경별)로부터 생성한다.
# 아래 값들은 GitHub 저장소의 dev / prod Environment Secrets 로 등록한다 (수동으로 서버에 만들 필요 없음).
#
# 애플 .p8 키 파일만은 시크릿(문자열)이 아니라 파일이므로, 서버 /opt/azit-batch/apple-keys/ 에 수동 배치한다.

# --- 배포 메타 (워크플로우가 입력값으로 채움) ---
DOCKER_USERNAME=       # secrets.DOCKER_USERNAME (저장소 공통)
IMAGE_TAG=latest       # 워크플로우 version 입력값
TARGET_PROFILE=dev     # 워크플로우 profile 입력값 (SPRING_PROFILES_ACTIVE)

# --- DB (RDS, 환경별로 다름) ---
DB_URL=jdbc:mysql://<rds-endpoint>:3306/azit?serverTimezone=Asia/Seoul
DB_USERNAME=
DB_PASSWORD=

# --- AWS S3 (프로필 이미지 삭제) ---
AWS_S3_ACCESS_KEY=
AWS_S3_SECRET_KEY=

# --- 카카오 (연동 해제 admin unlink) ---
KAKAO_ADMIN_KEY=

# --- 애플 (연동 해제 revoke). APPLE_KEY_PATH 는 컨테이너 내부 마운트 경로 ---
APPLE_TEAM_ID=
APPLE_SERVICE_ID=
APPLE_KEY_ID=
APPLE_KEY_PATH=/app/apple-keys/AuthKey_Prod_XXXXXXXX.p8

# --- Discord (배치 결과/실패 알림, 컨테이너에서 사용) ---
DISCORD_WEBHOOK_URL=

# --- New Relic (선택) ---
NEW_RELIC_LICENSE_KEY=
